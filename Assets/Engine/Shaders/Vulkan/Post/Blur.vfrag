#version 460

layout(set = 0, binding = 0) uniform sampler2D source;

layout(push_constant) uniform Blur {
    vec2 direction;
} blur;

layout(location = 0) in vec2 inUV;

layout(location = 0) out vec4 outColor;

void main() {
    vec2 texel = blur.direction / vec2(textureSize(source, 0));

    vec3 color = texture(source, inUV).rgb * 0.227027;
    color     += texture(source, inUV + texel).rgb * 0.1945946;
    color     += texture(source, inUV - texel).rgb * 0.1945946;
    color     += texture(source, inUV + texel * 2.0).rgb * 0.1216216;
    color     += texture(source, inUV - texel * 2.0).rgb * 0.1216216;
    color     += texture(source, inUV + texel * 3.0).rgb * 0.054054;
    color     += texture(source, inUV - texel * 3.0).rgb * 0.054054;

    outColor = vec4(color, 1.0);
}
