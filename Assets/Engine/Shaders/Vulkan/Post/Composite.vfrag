#version 460

#extension GL_ARB_shading_language_include : require

#include "../../Common/Tonemap.glsl"

layout(set = 0, binding = 0) uniform sampler2D hdrColor;
layout(set = 0, binding = 1) uniform sampler2D bloomColor;

layout(push_constant) uniform HdrPass {
    int enabled;
} hdrPass;

layout(location = 0) in vec2 inUV;
layout(location = 0) out vec4 outColor;

void main() {
    vec3 hdr   = texture(hdrColor, inUV).rgb;
    vec3 bloom = texture(bloomColor, inUV).rgb * 0.85;
    if (hdrPass.enabled == 0) {
        outColor = vec4(clamp(hdr, 0.0, 1.0) + bloom, 1.0);

        return;
    }

    outColor = vec4(acesTonemap(hdr + bloom), 1.0);
}
