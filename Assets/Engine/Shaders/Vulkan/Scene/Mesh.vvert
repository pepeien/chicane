#version 460

#extension GL_ARB_shading_language_include : require

#include "../../Common/Constant.glsl"
#include "../../Common/Poly/3D.glsl"

layout(set = 0, binding = 0) uniform Camera {
    vec4 clip;

    mat4 view;
    mat4 projection;

    vec4 up;
    vec4 right;
    vec4 forward;

    vec4 translation;
} camera;

layout(std430, set = 0, binding = 2) readonly buffer Scene {
    PolyInstance3D meshes[];
} instance;

layout(location = 0) out Data {
    flat ivec4 textureMaps[3];
    vec2 UV;
    vec3 normal;
    vec4 color;
    vec3 meshPosition;
    vec3 cameraPosition;
    float viewDepth;
} outData;

layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec4 inColor;
layout(location = 2) in vec2 inUV;
layout(location = 3) in vec3 inNormal;

void main() {
    PolyInstance3D mesh = instance.meshes[gl_InstanceIndex];

    vec4 position = vec4(inPosition, 1.0);

    outData.textureMaps[0] = mesh.textures0;
    outData.textureMaps[1] = mesh.textures1;
    outData.textureMaps[2] = mesh.textures2;
    outData.UV             = inUV;
    outData.normal         = mat3(transpose(inverse(mesh.model))) * inNormal;
    outData.color          = inColor;
    outData.meshPosition   = vec3(mesh.model * position);
    outData.cameraPosition = camera.translation.xyz;
    outData.viewDepth      = -(camera.view * vec4(outData.meshPosition, 1.0)).z;

    gl_Position = camera.projection * camera.view * mesh.model * position;
}
