#version 460

#extension GL_ARB_shading_language_include : require

#include "../../Common/Poly/3D.glsl"
#include "../../Common/View.glsl"

layout(set = 0, binding = 0) uniform Light {
    vec4 splits;
    vec4 info;

    mat4 views[4];
    mat4 projections[4];

    SceneLight lights[8];
} light;

layout(std430, set = 0, binding = 1) readonly buffer Scene {
    PolyInstance3D meshes[];
} instance;

layout(push_constant) uniform CascadePush {
    uint cascade;
} push;

layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec4 inColor;
layout(location = 2) in vec2 inUV;
layout(location = 3) in vec3 inNormal;

void main() {
    PolyInstance3D mesh = instance.meshes[gl_InstanceIndex];
    int cascade         = int(push.cascade);

    gl_Position = light.projections[cascade] * light.views[cascade] * mesh.model * vec4(inPosition, 1.0);
}
