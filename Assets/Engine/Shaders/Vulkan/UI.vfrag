#version 460

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(location = 0) out vec4 outColor;

layout(location = 0) in Data {
    flat int textureIndex;
    flat int glyphIndex;
    flat float glyphDilation;
    flat vec4 clip;
    flat vec2 view;
    vec2 UV;
    vec3 normal;
    vec4 color;
} inData;

layout(std430, set = 0, binding = 1) readonly buffer Glyph {
    float outlines[];
} glyph;

layout(set = 1, binding = 0) uniform sampler2D textures[];

#include "../Common/Glyph.glsl"

void main() {
    vec4 color = inData.color.rgba;

    // Resolved outside the branch so the derivatives below stay in uniform control flow.
    // The quad is grown by the dilation so the outline never reaches its own edge, where coverage would be clipped.
    int  offset    = max(inData.glyphIndex, 0);
    vec2 minBounds = getGlyphBoundsMin(offset) - inData.glyphDilation;
    vec2 maxBounds = getGlyphBoundsMax(offset) + inData.glyphDilation;
    vec2 position  = mix(minBounds, maxBounds, inData.UV);
    vec2 pixel     = fwidth(position);

    if (inData.glyphIndex >= 0) {
        color.a *= getGlyphCoverage(inData.glyphIndex, position, pixel);
    } else if (inData.textureIndex >= 0) {
        color.rgb = texture(textures[inData.textureIndex], inData.UV).rgb;
    }

    if (
        gl_FragCoord.x < inData.clip.x ||
        gl_FragCoord.y < inData.clip.y ||
        gl_FragCoord.x > inData.clip.z ||
        gl_FragCoord.y > inData.clip.w
    ) {
        discard;
    }

    outColor = color;
}
