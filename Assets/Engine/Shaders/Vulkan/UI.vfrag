#version 460

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(location = 0) out vec4 outColor;

layout(location = 0) in Data {
    flat int textureIndex;
    flat int glyphIndex;
    flat float glyphDilation;
    flat vec4 clip;
    flat vec2 view;
    flat vec4 box;
    flat vec4 radiusX;
    flat vec4 radiusY;
    flat vec4 innerClip;
    flat vec4 innerClipRadiusX;
    flat vec4 innerClipRadiusY;
    flat vec4 outerClip;
    flat vec4 outerClipRadiusX;
    flat vec4 outerClipRadiusY;
    vec2 UV;
    vec3 normal;
    vec4 color;
} inData;

layout(std430, set = 0, binding = 1) readonly buffer Glyph {
    float outlines[];
} glyph;

layout(set = 1, binding = 0) uniform sampler2D textures[];

#include "../Common/Glyph.glsl"
#include "../Common/Rounded.glsl"

void main() {
    vec4 color = inData.color.rgba;

    int  offset    = max(inData.glyphIndex, 0);
    vec2 minBounds = getGlyphBoundsMin(offset) - inData.glyphDilation;
    vec2 maxBounds = getGlyphBoundsMax(offset) + inData.glyphDilation;
    vec2 position  = mix(minBounds, maxBounds, inData.UV);
    vec2 pixel     = fwidth(position);

    if (inData.glyphIndex >= 0) {
        color.a *= getGlyphCoverage(inData.glyphIndex, position, pixel);
    } else if (inData.textureIndex >= 0) {
        color.rgb = texture(textures[inData.textureIndex], inData.UV).rgb;
    }

    vec2 frag = gl_FragCoord.xy;
    if (
        frag.x < inData.clip.x ||
        frag.y < inData.clip.y ||
        frag.x > inData.clip.z ||
        frag.y > inData.clip.w
    ) {
        discard;
    }

    if (
        hasRoundedCorners(inData.innerClipRadiusX, inData.innerClipRadiusY) &&
        !insideRoundedRect(frag, inData.innerClip, inData.innerClipRadiusX, inData.innerClipRadiusY)
    ) {
        discard;
    }

    if (
        hasRoundedCorners(inData.outerClipRadiusX, inData.outerClipRadiusY) &&
        !insideRoundedRect(frag, inData.outerClip, inData.outerClipRadiusX, inData.outerClipRadiusY)
    ) {
        discard;
    }

    if (
        inData.glyphIndex < 0 &&
        hasRoundedCorners(inData.radiusX, inData.radiusY)
    ) {
        color.a *= roundedRectCoverage(frag, inData.box, inData.radiusX, inData.radiusY);
    }

    outColor = color;
}
