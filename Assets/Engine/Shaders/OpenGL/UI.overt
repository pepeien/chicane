#version 460

#extension GL_ARB_shader_draw_parameters : require
#extension GL_ARB_shading_language_include : require

#include "../Common/Poly/2D.glsl"

layout(location = 0) out Data {
    flat int textureIndex;
    flat int glyphIndex;
    flat float glyphDilation;
    flat vec4 clip;
    flat vec4 view;
    flat vec4 box;
    flat vec4 radiusX;
    flat vec4 radiusY;
    flat vec4 innerClip;
    flat vec4 innerClipRadiusX;
    flat vec4 innerClipRadiusY;
    flat vec4 outerClip;
    flat vec4 outerClipRadiusX;
    flat vec4 outerClipRadiusY;
    vec2 UV;
    vec3 normal;
    vec4 color;
} outData;

layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec4 inColor;
layout(location = 2) in vec2 inUV;
layout(location = 3) in vec3 inNormal;

layout(std140, binding = 3) readonly buffer Grid {
    PolyInstance2D components[];
} instance;

void main() {
    PolyInstance2D component = instance.components[gl_InstanceID + gl_BaseInstance];

    vec2 originalScale = component.scale;
    vec2 blurredScale  = get2DBlurredScale(component);
    component.scale    = blurredScale;

    vec2 vertexPosition = get2DVertexPosition(component, inPosition.xy, vec2(1.0));
    vec3 screenPosition = get2DScreenPosition(component, vec2(1.0, -1.0));

    outData.textureIndex     = component.textureIndex;
    outData.glyphIndex       = component.glyphIndex;
    outData.glyphDilation    = component.glyphDilation;
    outData.clip             = component.clip;
    outData.view             = vec4(component.view, component.filterBlur, component.backdropBlur);
    outData.box              = vec4(component.position.xy, component.position.xy + component.size);
    outData.radiusX          = component.radiusX;
    outData.radiusY          = component.radiusY;
    outData.innerClip        = component.innerClip;
    outData.innerClipRadiusX = component.innerClipRadiusX;
    outData.innerClipRadiusY = component.innerClipRadiusY;
    outData.outerClip        = component.outerClip;
    outData.outerClipRadiusX = component.outerClipRadiusX;
    outData.outerClipRadiusY = component.outerClipRadiusY;
    outData.UV               = get2DFilterUV(inUV, originalScale, blurredScale);
    outData.normal           = inNormal;
    outData.color            = normalize2DColor(component.color);

    gl_Position  = vec4(vertexPosition + screenPosition.xy, screenPosition.z, 1.0);
}
