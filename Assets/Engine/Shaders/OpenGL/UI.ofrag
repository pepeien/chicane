#version 460

#extension GL_ARB_shading_language_include : require

layout(location = 0) out vec4 outColor;

layout(location = 0) in Data {
    flat int textureIndex;
    flat int glyphIndex;
    flat float glyphDilation;
    flat vec4 clip;
    flat vec4 view;
    flat vec4 box;
    flat vec4 linear;
    flat vec4 radiusX;
    flat vec4 radiusY;
    flat vec4 innerClip;
    flat vec4 innerClipRadiusX;
    flat vec4 innerClipRadiusY;
    flat vec4 outerClip;
    flat vec4 outerClipRadiusX;
    flat vec4 outerClipRadiusY;
    vec2 UV;
    vec3 normal;
    vec4 color;
} inData;

layout(std430, binding = 4) readonly buffer Glyph {
    float outlines[];
} glyph;

layout(location = 0) uniform sampler2DArray textures;
layout(binding = 1, location = 1) uniform sampler2D backdrop;
layout(binding = 2, location = 2) uniform sampler2D screenTarget;
layout(location = 3) uniform int screenTextureIndex;

#include "../Common/Glyph.glsl"
#include "../Common/Rounded.glsl"
#include "../Common/Filter.glsl"

vec3 sampleUITexture(int textureIndex, vec2 uv) {
    vec2 texUV  = clamp(uv, 0.0, 1.0);
    vec3 atlas  = texture(textures, vec3(texUV, float(max(textureIndex, 0)))).rgb;
    vec3 screen = texture(screenTarget, texUV).rgb;

    return textureIndex == screenTextureIndex ? screen : atlas;
}

void main() {
    vec4 color = inData.color.rgba;

    // Resolved outside the branch so the derivatives below stay in uniform control flow.
    // The quad is grown by the dilation so the outline never reaches its own edge, where coverage would be clipped.
    int  offset    = max(inData.glyphIndex, 0);
    vec2 minBounds = getGlyphBoundsMin(offset) - inData.glyphDilation;
    vec2 maxBounds = getGlyphBoundsMax(offset) + inData.glyphDilation;
    vec2 position  = mix(minBounds, maxBounds, inData.UV);
    vec2 pixel     = fwidth(position) * (1.0 + max(inData.view.z, 0.0));

    if (inData.glyphIndex >= 0) {
        color.a *= getGlyphCoverage(inData.glyphIndex, position, pixel);
    } else if (inData.textureIndex >= 0) {
        vec3 rgb = sampleUITexture(inData.textureIndex, inData.UV);

        if (inData.view.z >= 0.5) {
            vec2  texel = vec2(inData.view.z) / max(inData.box.zw - inData.box.xy, vec2(1.0));
            vec3  acc   = vec3(0.0);
            float wsum  = 0.0;

            for (int y = -1; y <= 1; y++) {
                for (int x = -1; x <= 1; x++) {
                    vec2  tap = inData.UV + (vec2(float(x), float(y)) * texel);
                    float w   = exp(-0.5 * float((x * x) + (y * y)) / 2.0);

                    acc  += sampleUITexture(inData.textureIndex, tap) * w;
                    wsum += w;
                }
            }

            rgb = acc / max(wsum, 1e-4);
        }

        color.rgb = rgb;
    }

    vec2 frag = vec2(gl_FragCoord.x, inData.view.y - gl_FragCoord.y);
    vec2 localFrag = frag;
    {
        vec2  center = mix(inData.box.xy, inData.box.zw, 0.5);
        mat2  linear = mat2(inData.linear.xy, inData.linear.zw);
        float det    = (linear[0][0] * linear[1][1]) - (linear[0][1] * linear[1][0]);

        if (abs(det) >= 1e-6) {
            localFrag = center + (inverse(linear) * (frag - center));
        }
    }
    if (frag.x < inData.clip.x || frag.y < inData.clip.y ||
        frag.x > inData.clip.z || frag.y > inData.clip.w) {
        discard;
    }

    if (hasRoundedCorners(inData.innerClipRadiusX, inData.innerClipRadiusY) &&
        !insideRoundedRect(frag, inData.innerClip, inData.innerClipRadiusX, inData.innerClipRadiusY)) {
        discard;
    }

    if (hasRoundedCorners(inData.outerClipRadiusX, inData.outerClipRadiusY) &&
        !insideRoundedRect(frag, inData.outerClip, inData.outerClipRadiusX, inData.outerClipRadiusY)) {
        discard;
    }

    if (inData.glyphIndex < 0) {
        float coverage = 1.0;

        if (inData.view.z > 0.0) {
            coverage = filterGaussianCoverage(
                roundedRectSDF(localFrag, inData.box, inData.radiusX, inData.radiusY),
                inData.view.z
            );
        } else if (hasRoundedCorners(inData.radiusX, inData.radiusY)) {
            coverage = roundedRectCoverage(localFrag, inData.box, inData.radiusX, inData.radiusY);
        }

        if (inData.view.w > 0.0) {
            vec3 backdropColor = sampleBackdropBlur(backdrop, gl_FragCoord.xy, inData.view.xy, inData.view.w);

            color.rgb = (color.rgb * color.a) + (backdropColor * (1.0 - color.a));
            color.a   = coverage;
        } else {
            color.a *= coverage;
        }
    }

    outColor = color;
}
