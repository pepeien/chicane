#version 460

#extension GL_ARB_shading_language_include : require
#extension GL_ARB_shader_draw_parameters : require

#include "../../Common/Constant.glsl"
#include "../../Common/Poly/3D.glsl"
#include "../../Common/View.glsl"

layout(std430, binding = 0) readonly buffer Scene {
    CameraInstance camera;
    LightInstance light;
    PolyInstance3D meshes[];
} scene;

layout(location = 0) out Data {
    flat ivec4 textureMaps[3];
    flat int bIsLit;
    flat float emissiveStrength;
    vec2 UV;
    vec3 normal;
    vec4 tangent;
    vec4 color;
    vec3 meshPosition;
    vec3 cameraPosition;
    float viewDepth;
} outData;

layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec4 inColor;
layout(location = 2) in vec2 inUV;
layout(location = 3) in vec3 inNormal;
layout(location = 4) in vec4 inTangent;

void main() {
    CameraInstance camera = scene.camera;
    PolyInstance3D mesh   = scene.meshes[gl_InstanceID + gl_BaseInstance];

    vec4 position     = vec4(inPosition, 1.0);
    mat3 normalMatrix = mat3(transpose(inverse(mesh.model)));

    outData.textureMaps[0]   = mesh.textures0;
    outData.textureMaps[1]   = mesh.textures1;
    outData.textureMaps[2]   = mesh.textures2;
    outData.bIsLit           = (mesh.flags & POLY_FLAG_LIT) != 0 ? 1 : 0;
    outData.emissiveStrength = mesh.emissiveStrength;
    outData.UV               = inUV;
    outData.normal           = normalMatrix * inNormal;
    outData.tangent          = vec4(normalMatrix * inTangent.xyz, inTangent.w);
    outData.color            = inColor;
    outData.meshPosition     = vec3(mesh.model * position);
    outData.cameraPosition   = camera.translation.xyz;
    outData.viewDepth        = -(camera.view * vec4(outData.meshPosition, 1.0)).z;

    gl_Position = camera.projection * camera.view * mesh.model * position;
}
