#version 460

#extension GL_ARB_shading_language_include : require
#extension GL_ARB_shader_draw_parameters : require

#include "../../Common/Particle.glsl"
#include "../../Common/View.glsl"

layout(std430, binding = 0) readonly buffer Scene {
    CameraInstance camera;
} scene;

layout(std430, binding = 4) readonly buffer Particles {
    GpuParticle particles[];
} data;

layout(location = 0) out Data {
    vec2 uv;
    vec4 color;
    float additive;
} outData;

vec2 quadCorner(uint inIndex) {
    if (inIndex == 0u) {
        return vec2(-0.5, -0.5);
    }
    if (inIndex == 1u) {
        return vec2(0.5, -0.5);
    }
    if (inIndex == 2u) {
        return vec2(-0.5, 0.5);
    }

    return vec2(0.5, 0.5);
}

void main() {
    GpuParticle particle = data.particles[gl_InstanceID];

    vec3 position  = particle.positionRotation.xyz;
    float rotation = particle.positionRotation.w;

    vec2 size = particle.sizeAge.xy;
    vec3 axis = particle.axis.xyz;

    vec2 corner = quadCorner(uint(gl_VertexID));
    vec2 uv     = corner + vec2(0.5);

    vec3 offset = vec3(0.0);
    if (dot(axis, axis) > 0.0001) {
        vec3 along = normalize(axis);
        vec3 toCamera = scene.camera.translation.xyz - position;

        vec3 side = cross(along, toCamera);
        if (dot(side, side) < 0.0001) {
            side = scene.camera.right.xyz;
        }

        side   = normalize(side);
        offset = along * (corner.x * size.x) + side * (corner.y * size.y);
    } else {
        float cosine = cos(rotation);
        float sine   = sin(rotation);
        vec2 rotated = vec2(corner.x * cosine - corner.y * sine, corner.x * sine + corner.y * cosine);

        offset = scene.camera.right.xyz * (rotated.x * size.x) + scene.camera.up.xyz * (rotated.y * size.y);
    }

    outData.uv       = uv;
    outData.color    = particle.color;
    outData.additive = particle.sizeAge.w;

    gl_Position = scene.camera.projection * scene.camera.view * vec4(position + offset, 1.0);
}
