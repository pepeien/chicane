#version 460

struct CameraInstance {
    vec4 clip;

    mat4 view;
    mat4 projection;

    vec4 up;
    vec4 right;
    vec4 forward;

    vec4 translation;
};

layout(std430, binding = 0) readonly buffer Scene {
    CameraInstance camera;
} scene;

layout(location = 0) out Data {
    vec4 color;
    vec3 normal;
} outData;

layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec4 inColor;
layout(location = 2) in vec2 inUV;
layout(location = 3) in vec3 inNormal;

void main() {
    outData.color  = inColor;
    outData.normal = inNormal;

    gl_Position = scene.camera.projection * scene.camera.view * vec4(inPosition, 1.0);
}
