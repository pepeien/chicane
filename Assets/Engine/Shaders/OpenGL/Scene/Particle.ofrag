#version 460

layout(location = 0) out vec4 outColor;

layout(location = 0) in Data {
    vec2 uv;
    vec4 color;
    float additive;
} inData;

void main() {
    vec2 centered = inData.uv * 2.0 - 1.0;

    float falloff = clamp(1.0 - dot(centered, centered), 0.0, 1.0);
    falloff       = pow(falloff, 1.4);

    vec4 color = inData.color;
    color.a   *= falloff;
    color.rgb *= color.a;

    outColor = color;
}
