Window {
    position: absolute;
    z-index: 80;

    &:drag {
        cursor: grabbing;
    }
}

.window {
    width: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 0.75em;
    background-color: transparent;

    &__bar {
        width: 100%;
        height: 1.8em;
        display: flex;
        flex-direction: row;
        padding: 0.35em 0.6em;
        background-color: white;
        border-bottom: 1px solid gray;
        border-radius: 0.75em 0.75em 0 0;
        cursor: grab;
    }

    &__title {
        margin: auto 0;
        color: black;
        font-size: 0.75em;
    }

    &__close {
        width: 1.1em;
        height: 1.1em;
        margin: auto 0 auto auto;
        cursor: pointer;
        overflow: hidden;

        Text {
            margin: auto;
            color: gray;
            font-size: 0.75em;
        }
    }

    &__body {
        width: 100%;
        display: flex;
        flex-direction: column;
    }
}
