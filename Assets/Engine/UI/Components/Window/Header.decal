Window::Header {
    width: 100%;
}

.window-header {
    width: 100%;
    height: 1.8em;
    display: flex;
    flex-direction: row;
    padding: 0.35em 0.6em;
    background-color: #f4f4f4;
    border-bottom: 1px solid #e4e4e4;
    border-radius: 0.75em 0.75em 0 0;
    cursor: grab;

    &__label {
        margin: auto 0;
        color: #333333;
        font-size: 0.75em;
    }

    &__close {
        width: 1.1em;
        height: 1.1em;
        margin: auto 0 auto auto;
        cursor: pointer;
        overflow: hidden;

        Text {
            margin: auto;
            color: #666666;
            font-size: 0.75em;
        }
    }
}
