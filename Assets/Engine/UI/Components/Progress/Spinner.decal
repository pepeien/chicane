@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

Progress::Spinner {
    width: 1.5em;
    height: 1.5em;
    overflow: visible;
}

.progress-spinner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;

    &__ring {
        width: 100%;
        height: 100%;
        border: 0.18em solid rgba(255, 255, 255, 0.2);
        border-top-color: #ffffff;
        border-radius: 50%;
        transform-origin: center;
        animation: spin 750ms linear infinite;
    }

    &.--idle .progress-spinner__ring {
        animation-name: none;
        opacity: 0.35;
    }
}
