<Container class="input-color --{{ openState }}">
    <Button class="input-color__swatch" onClick="{{ toggle() }}">
        <Container class="input-color__swatch__fill" />
    </Button>
    <Container dir:if="{{ isOpen }}" class="input-color__popup">
        <Container class="input-color__body">
            <Container class="input-color__picker">
                <Container id="colorWheel" class="input-color__wheel">
                    <Container class="input-color__disc" />
                    <Container class="input-color__shade" />
                    <Container class="input-color__cursor" />
                </Container>
                <Container id="colorValue" class="input-color__value">
                    <Container class="input-color__value__thumb" />
                </Container>
            </Container>
            <Container class="input-color__tabs">
                <Button class="input-color__tab --{{ rgbState }}" onClick="{{ setRgbModel() }}">
                    <Text>RGB</Text>
                </Button>
                <Button class="input-color__tab --{{ rgbaState }}" onClick="{{ setRgbaModel() }}">
                    <Text>RGBA</Text>
                </Button>
                <Button class="input-color__tab --{{ hsvState }}" onClick="{{ setHsvModel() }}">
                    <Text>HSV</Text>
                </Button>
            </Container>
            <Container dir:if="{{ isHsv }}" class="input-color__channels">
                <Input::ButtonSlider
                    label="Hue"
                    value="{{ hue }}"
                    min="0"
                    max="360"
                    step="1"
                    precision="0"
                    onInput="{{ commitHsv() }}"
                />
                <Input::ButtonSlider
                    label="Saturation"
                    value="{{ saturation }}"
                    min="0"
                    max="100"
                    step="1"
                    precision="0"
                    onInput="{{ commitHsv() }}"
                />
                <Input::ButtonSlider
                    label="Value"
                    value="{{ brightness }}"
                    min="0"
                    max="100"
                    step="1"
                    precision="0"
                    onInput="{{ commitHsv() }}"
                />
            </Container>
            <Container dir:if="{{ isRgb }}" class="input-color__channels">
                <Input::ButtonSlider
                    label="Red"
                    value="{{ red }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
                <Input::ButtonSlider
                    label="Green"
                    value="{{ green }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
                <Input::ButtonSlider
                    label="Blue"
                    value="{{ blue }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
            </Container>
            <Container dir:if="{{ isRgba }}" class="input-color__channels">
                <Input::ButtonSlider
                    label="Red"
                    value="{{ red }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
                <Input::ButtonSlider
                    label="Green"
                    value="{{ green }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
                <Input::ButtonSlider
                    label="Blue"
                    value="{{ blue }}"
                    min="0"
                    max="255"
                    step="1"
                    precision="0"
                    onInput="{{ commitRgb() }}"
                />
                <Input::ButtonSlider
                    label="Alpha"
                    value="{{ alphaUnit }}"
                    min="0"
                    max="1"
                    step="0.01"
                    onInput="{{ commitRgb() }}"
                />
            </Container>
            <Container class="input-color__hex-row">
                <Text class="input-color__hex-label">Hex</Text>
                <Input::Text class="input-color__hex" value="{{ hex }}" onInput="{{ commitHex() }}" />
            </Container>
        </Container>
    </Container>
</Container>
