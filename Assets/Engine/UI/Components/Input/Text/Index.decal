@keyframes blink {
    from { opacity: 1; }
    to   { opacity: 0; }
}

Input::Text {
    position: relative;
    cursor: text;
    overflow: hidden;

    .input-text__selection {
        position: absolute;
        margin-left: ref(selection.x);
        margin-top: ref(selection.y);
        width: ref(selectionWidth);
        height: 1em;
        background-color: blue;
        overflow: hidden;
    }

    .input-text__caret {
        position: absolute;
        width: 0.08em;
        min-width: 1px;
        height: 1em;
        background-color: ref(caretColor);
        margin-left: ref(caret.x);
        margin-top: ref(caret.y);
        opacity: 0;
        z-index: 1;
        animation-name: none;
    }

    &:focus .input-text__caret {
        opacity: 1;
        animation: blink 1s ease-in-out infinite alternate;
    }
}
