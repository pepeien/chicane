$sliderThumb: 0.75em;

Input::Slider {
    width: 100%;
    height: 1.1em;
    cursor: pointer;
    overflow: visible;
}

.input-slider {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;

    &__track {
        width: 100%;
        height: 0.28em;
        margin: auto 0;
        border-radius: 1em;
        overflow: hidden;
    }

    &__fill {
        width: ref(percentage)%;
        height: 100%;
    }

    &__thumb {
        position: absolute;
        width: $sliderThumb;
        height: $sliderThumb;
        margin-top: calc(calc(100% - $sliderThumb) * 0.5);
        margin-left: calc(calc(100% - $sliderThumb) * ref(percentage) / 100);
        border-radius: 1em;
    }
}
