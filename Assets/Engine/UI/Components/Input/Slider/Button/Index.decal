$sliderNudgeGap: 0.15em;

Input::ButtonSlider {
    width: 100%;
    height: 1.4em;
}

.input-button-slider {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    gap: $sliderNudgeGap;

    &__nudge {
        width: auto;
        height: 100%;
        padding: 0 0.25em;
        display: flex;
        cursor: pointer;
        overflow: hidden;
        background-color: #3a3a3a;
        border-radius: 4px;
        transition: background-color 200ms ease-in-out;

        &:hover {
            background-color: #4a4a4a;
        }
    }

    &__chevron {
        margin: auto;
        color: white;
        font-size: 0.85em;
    }

    &__track {
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        flex-direction: row;
        overflow: hidden;
        cursor: ew-resize;
        background-color: #4a4a4a;
        border-radius: 4px;
        transition: background-color 200ms ease-in-out;

        &:hover {
            background-color: #525252;
        }
    }

    &__fill {
        position: absolute;
        width: ref(percentage)%;
        height: 100%;
        background-color: #5e5e5e;
        overflow: hidden;
    }

    &__values {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 100%;
        padding: 0 0.45em;
    }

    &__label {
        min-width: 2.8em;
        height: 1em;
        margin: auto 0;
        color: white;
        font-size: 0.62em;
        z-index: 1;
    }

    &__value {
        min-width: 2.8em;
        height: 1em;
        margin: auto 0 auto auto;
        color: white;
        font-size: 0.62em;
        z-index: 1;
        cursor: text;
        alignment: right;
    }
}