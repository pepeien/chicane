$rangeField: 2.8em;
$rangeGap: 0.2em;
$rangeHandle: 0.42em;

Input::RangeSlider {
    width: 100%;
    height: 1.4em;
}

.input-range-slider {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    gap: $rangeGap;

    &__field {
        width: $rangeField;
        min-width: $rangeField;
        height: 100%;
        display: flex;
        overflow: hidden;
        background-color: #2b2b2b;
        border-radius: 2px;
    }

    &__value {
        width: 100%;
        height: 1em;
        margin: auto 0;
        color: #dedede;
        font-size: 0.72em;
        cursor: text;
    }

    &__track {
        width: calc(100% - $rangeField - $rangeField - $rangeGap - $rangeGap);
        height: 0.72em;
        margin: auto 0;
        position: relative;
        cursor: ew-resize;
        background-color: #1c1c1c;
        border-radius: 2px;
    }

    &__span {
        position: absolute;
        width: ref(spanPercent)%;
        height: 100%;
        margin-left: ref(lowPercent)%;
        cursor: grab;
        background-color: #4f7d96;
        border-radius: 2px;
    }

    &__handle {
        position: absolute;
        width: $rangeHandle;
        height: 1.05em;
        overflow: hidden;
        cursor: ew-resize;
        background-color: #8eb6c9;
        border-radius: 1px;

        &.--low {
            margin: auto auto auto -0.12em;
        }

        &.--high {
            margin: auto -0.12em auto auto;
        }
    }
}
