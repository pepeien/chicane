$sliderThumb: 0.75em;

Input::Slider {
    width: 100%;
    height: 100%;
}

.input-slider {
    width: 100%;
    height: 100%;
    position: relative;

    &:hover {
        cursor: pointer;
    }

    &__track {
        width: 100%;
        height: 0.28em;
        margin: auto 0;
        border-radius: 1em;
        background-color: gray;
    }

    &__fill {
        position: relative;
        width: ref(percentage)%;
        height: 100%;
        background-color: black;
    }

    &__thumb {
        position: absolute;
        width: $sliderThumb;
        height: $sliderThumb;
        margin: auto 0 auto auto;
        background-color: green;
        z-index: 2;
    }
}

Input::Slider.--overlay {
    width: 78%;
    height: 1.15em;
    position: absolute;
    cursor: ew-resize;
}
