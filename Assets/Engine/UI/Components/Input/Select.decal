Input::Select {
    position: relative;
    overflow: visible;
    cursor: pointer;
}

.input-select {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;

    &__control {
        width: 100%;
        height: 100%;
        display: flex;
        cursor: pointer;
        overflow: hidden;
    }

    &__label {
        margin: auto;
    }

    &__list {
        position: absolute;
        width: 100%;
        margin-top: 1.25em;
        z-index: 200;
        display: flex;
        flex-direction: column;
        overflow: visible;
        background-color: #ffffff;
        border: 1px solid #d8d8d8;
        border-radius: 0.3em;
    }
}

Input::Select::Option {
    width: 100%;
    min-height: 1.4em;
    height: 1.4em;
    display: flex;
    cursor: pointer;
    overflow: hidden;

    Text {
        margin: auto 0.4em;
    }
}
