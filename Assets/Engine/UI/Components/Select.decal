Select {
    position: relative;
    overflow: visible;
    cursor: pointer;
}

.select {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;

    &__control {
        width: 100%;
        height: 100%;
        display: flex;
        cursor: pointer;
        overflow: hidden;
    }

    &__label {
        margin: auto;
    }

    &__list {
        position: absolute;
        width: 100%;
        margin-top: 100%;
        z-index: 20;
        display: flex;
        flex-direction: column;
        overflow: auto;
    }
}

Option {
    width: 100%;
    display: flex;
    cursor: pointer;
    overflow: hidden;

    Text {
        margin: 0.25em 0.4em;
    }
}
