// Color
$grayColor: rgba(51, 51, 51, 0.25);

// Crosshair
$xhairPixel:     calc(100vh / 480px);
$xhairSize:      calc(ref(crosshairSize) * $xhairPixel);
$xhairThickness: calc(ref(crosshairThickness) * $xhairPixel);
$xhairGap:       calc(ref(crosshairGap) * $xhairPixel);
$xhairInner:     calc($xhairGap + calc($xhairThickness * 0.5));

@keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.victory {
    position: absolute;
    display: flex;
    width: 100%;
    height: 100vh;
    backdrop-filter: blur(5px);
    background-color: $grayColor;
    z-index: 2;
    opacity: 0;
    animation: fade-in 300ms ease-in-out forwards;

    Text {
        font-size: 8vw;
        margin: auto;
    }
}

.score {
    margin-top: auto;
    position: absolute;
    background-color: rgba($grayColor, 0.3);
    font-size: 1.5em;
    padding: 0.5em;
}

.crosshair {
    position: absolute;
    display: flex;
    width: 100%;
    height: 100vh;

    &__origin {
        position: relative;
        margin: auto;
        width: 0;
        height: 0;
    }

    &__dot, &__top, &__bottom, &__left, &__right {
        position: absolute;
        background-color: rgba(ref(crosshairColorR), ref(crosshairColorG), ref(crosshairColorB), ref(crosshairColorA));
    }

    &__top, &__bottom {
        height: $xhairSize;
        width: $xhairThickness;
        margin-left: calc($xhairThickness * -0.5);
    }

    &__left, &__right {
        height: $xhairThickness;
        width: $xhairSize;
        margin-top: calc($xhairThickness * -0.5);
    }

    &__dot {
        display: ref(crosshairDotVisibility);
        width: $xhairThickness;
        height: $xhairThickness;
        margin-top: calc($xhairThickness * -0.5);
        margin-left: calc($xhairThickness * -0.5);
    }

    &__top {
        margin-top: calc(calc($xhairSize * -1) + calc($xhairInner * -1));
    }

    &__bottom {
        margin-top: $xhairInner;
    }

    &__left {
        margin-left: calc(calc($xhairSize * -1) + calc($xhairInner * -1));
    }

    &__right {
        margin-left: $xhairInner;
    }
}