$grayColor: rgba(51, 51, 51, 0.25);

@keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.victory {
    position: absolute;
    display: flex;
    width: 100%;
    height: 100vh;
    backdrop-filter: blur(5px);
    background-color: $grayColor;
    z-index: 2;
    opacity: 0;
    animation: fade-in 300ms ease-in-out forwards;

    Text {
        font-size: 8vw;
        margin: auto;
    }
}

.score {
    margin-top: auto;
    position: absolute;
    background-color: rgba($grayColor, 0.3);
    font-size: 1.5em;
    padding: 0.5em;
}
