<View path="home">
    <Container class="victory">
        <Text class="victory__prompt">Victory</Text>
        <Button>
            <Text>Restart</Text>
        </Button>
    </Container>
    <Sample::Telemetry />
    <Text class="score">Score 0 / 0</Text>
    <Sample::Crosshair settings="{{ crosshair }}" />
</View>
