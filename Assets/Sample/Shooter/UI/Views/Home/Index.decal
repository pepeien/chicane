$grayColor: rgba(51, 51, 51, 0.25);

@keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.victory {
    position: absolute;
    display: none;
    width: 100%;
    height: 100vh;
    backdrop-filter: blur(15px);
    background-color: $grayColor;
    z-index: 2;
    opacity: 0;

    &.--shown {
        display: flex;
        flex-direction: column;
        gap: 0.65em;
        animation: fade-in 300ms ease-in-out forwards;
    }

    &__prompt {
        font-size: 8vw;
        margin: 35% auto 0 auto;
    }

    Button {
        padding: 0.5em 4em;
        background-color: gray;
        margin: 0 auto;
        transition: background-color 200ms ease-in-out;

        Text {
            font-size: 2em;
            color: white;
            transition: color 200ms ease-in-out;
        }

        &:hover {
            cursor: pointer;
            background-color: white;

            Text {
                color: gray;
            }
        }
    }
}

.score {
    margin-top: auto;
    position: absolute;
    background-color: rgba($grayColor, 0.3);
    font-size: 1.5em;
    padding: 0.5em;
}
