Instance.onLoad(function()
    local score = Instance.find(".score")
    local banner = Instance.find(".victory")

    if banner then
        banner:setVisible(false)
    end

    Instance.subscribe("score", function(data)
        if score then
            score:setText("Score " .. data)
        end
    end)

    Instance.subscribe("victory", function()
        if banner then
            banner:setVisible(true)
        end
    end)
end)

function onFire()
    Instance.send("hud:fire", "")
end
