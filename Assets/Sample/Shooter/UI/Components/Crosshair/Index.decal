$xhairPixel:     calc(100vh / 480px);
$xhairSize:      calc(ref(settings.size) * $xhairPixel);
$xhairThickness: calc(ref(settings.thickness) * $xhairPixel);
$xhairGap:       calc(ref(settings.gap) * $xhairPixel);
$xhairInner:     calc($xhairGap + calc($xhairThickness * 0.5));

Sample::Crosshair {
    position: absolute;
    display: flex;
    width: 100%;
    height: 100vh;
}

.crosshair {
    width: 100%;
    height: 100%;
    display: flex;

    &__origin {
        position: relative;
        margin: auto;
        width: 0;
        height: 0;
    }

    &__dot, &__top, &__bottom, &__left, &__right {
        position: absolute;
        background-color: ref(settings.color);
    }

    &__top, &__bottom {
        height: $xhairSize;
        width: $xhairThickness;
        margin-left: calc($xhairThickness * -0.5);
    }

    &__left, &__right {
        height: $xhairThickness;
        width: $xhairSize;
        margin-top: calc($xhairThickness * -0.5);
    }

    &__dot {
        display: ref(settings.dot);
        width: $xhairThickness;
        height: $xhairThickness;
        margin-top: calc($xhairThickness * -0.5);
        margin-left: calc($xhairThickness * -0.5);
    }

    &__top {
        margin-top: calc(calc($xhairSize * -1) + calc($xhairInner * -1));
    }

    &__bottom {
        margin-top: $xhairInner;
    }

    &__left {
        margin-left: calc(calc($xhairSize * -1) + calc($xhairInner * -1));
    }

    &__right {
        margin-left: $xhairInner;
    }
}
