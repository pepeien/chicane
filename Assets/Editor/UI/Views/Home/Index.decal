$contentPadding: 0.35em;
$contentPaddingDouble: calc($contentPadding * 2);

.--light {
    $--green: #0b997d;
    $--orange: #d4a017;

    $--gray: #aaaaaa;
    $--lighter-gray: #6b6262;
    $--light-gray: #423e3e;
    $--dark-gray: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;
    $--orange: #d4a017;

    $--gray: #aaaaaa;
    $--lighter-gray: #6b6262;
    $--light-gray: #423e3e;
    $--dark-gray: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    display: flex;
    flex-direction: column;
    transition: background-color 200ms ease-in-out;
    background-color: $--white;

    RouterView {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    &__content {
        width: 100%;
        height: 100%;
        padding: $contentPadding;
        gap: $contentPadding;
        background-color: $--light-gray;

        Text {
            color: $--black;
        }

        DockPanel {
            background-color: $--white;
            border: 1px solid $--lighter-gray;
            border-radius: 4px;
            overflow: hidden;
        }

        Editor::Toolbar {
            position: absolute;
            margin: 0.5em 0 0 0.5em;
            width: auto;
            height: auto;
        }

        Editor::Telemetry {
            position: absolute;
            margin: 0.5em 0.5em 0 auto;
        }

        Viewport {
            width: 100%;
            height: 100%;
        }

        Editor::Outliner {
            width: 100%;
            height: 100%;
        }

        Editor::Attributes {
            width: 100%;
            height: 100%;
        }

        Editor::Explorer {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        Editor::Console {
            escape: true;
        }

        Editor::AssetManager {
            width: 100%;
            height: 100%;
        }
    }

    .view-preview {
        width: 24em;
        height: 16em;
        min-width: 16em;
        min-height: 10em;
        margin-top: 6em;
        margin-left: 46%;
        z-index: 140;
        background-color: $--dark-gray;
        border: 1px solid $--lighter-gray;

        Viewport {
            width: 100%;
            height: 100%;
        }
    }
}