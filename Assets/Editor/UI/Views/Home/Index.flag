local ACTIVE = "active"
local IDLE   = "idle"

local function home()
    return Instance.view()
end

local function applyWorkspace(name)
    local view = home()
    if not view then
        return
    end

    local isViewport = name == "viewport"
    view.workspace            = name
    view.bIsViewportWorkspace = isViewport
    view.bIsAssetsWorkspace   = not isViewport
    view.viewportTabState     = isViewport and ACTIVE or IDLE
    view.assetsTabState       = isViewport and IDLE or ACTIVE
end

function onWorkspaceViewport()
    applyWorkspace("viewport")
    Instance.invoke("onWorkspaceViewport")
end

function onWorkspaceAssets()
    applyWorkspace("assets")
    Instance.invoke("onWorkspaceAssets")
end

function onThemeSwitch(value)
    local view = home()
    if view then
        view.theme = value or ""
    end
end

function onTrackNew()
    Instance.invoke("onTrackNew")
end

function onTrackOpen()
    Instance.invoke("onTrackOpen")
end

function onTrackSave()
    Instance.invoke("onTrackSave")
end

function onTrackSaveAs()
    Instance.invoke("onTrackSaveAs")
end

function onItemEdit()
    Instance.invoke("onItemEdit")
end

function onItemDelete()
    Instance.invoke("onItemDelete")
end

function onItemIdCommit()
    Instance.invoke("onItemIdCommit")
end

function onAssetImport()
    Instance.invoke("onAssetImport")
end

function onExplorerAssetDrop(path)
    Instance.invoke("onExplorerAssetDrop", path or "")
end
