<View path="home" class="home --{{ theme }}">
    <Header />
    <Dock class="home__content">
        <DockPanel isGrabbable="false">
            <Telemetry />
            <Viewport />
        </DockPanel>
        <DockPanel side="left" size="15%" handle="outlinerHeader">
            <Outliner />
        </DockPanel>
        <DockPanel side="right" size="20%" handle="attributesHeader">
            <Attributes />
        </DockPanel>
    </Dock>
    <Dock class="home__footer">
        <DockPanel size="100%" handle="explorerHeader">
            <Explorer />
        </DockPanel>
    </Dock>
</View>
