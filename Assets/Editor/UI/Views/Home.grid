<View path="home" class="--{{ theme }}">
    <Telemetry />
    <Button class="theme-button" onClick="{{ onThemeSwitch() }}">
        <Text>Switch Theme</Text>
    </Button>
    <Container class="outliner --menu">
        <Container class="outliner__items">
            <Button dir:for="actor : outlinerActors" class="outliner__item">
                <Text>{{ actor.translation }}</Text>
            </Button>
        </Container>
    </Container>
    <Explorer />
</View>
