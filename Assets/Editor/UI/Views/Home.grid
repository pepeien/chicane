<View path="home" class="home --{{ theme }}">
    <Editor::Header
        theme="{{ theme }}"
        viewportTabState="{{ viewportTabState }}"
        assetsTabState="{{ assetsTabState }}"
        onWorkspaceViewport="{{ onWorkspaceViewport }}"
        onWorkspaceAssets="{{ onWorkspaceAssets }}"
    />
    <Dock dir:if="{{ bIsViewportWorkspace }}" class="home__content">
        <DockPanel side="top" max-size="6em" handle="toolbarHeader" isResizable="false">
            <Editor::Toolbar
                orientation="{{ orientation }}"
                translateState="{{ translateState }}"
                rotateState="{{ rotateState }}"
                scaleState="{{ scaleState }}"
                onTrackSave="{{ onTrackSave }}"
                onGizmoTranslate="{{ onGizmoTranslate }}"
                onGizmoRotate="{{ onGizmoRotate }}"
                onGizmoScale="{{ onGizmoScale }}"
            />
        </DockPanel>
        <DockPanel isGrabbable="false">
            <Viewport />
            <Editor::Telemetry />
            <Editor::ShowFlags />
        </DockPanel>
        <DockPanel side="left" size="15%" handle="outlinerHeader">
            <Editor::Outliner
                outlinerNodes="{{ outlinerNodes }}"
                onItemSelection="{{ onItemSelection }}"
                onItemToggle="{{ onItemToggle }}"
                onItemEdit="{{ onItemEdit }}"
                onItemIdInput="{{ onItemIdInput }}"
                onItemIdCommit="{{ onItemIdCommit }}"
            />
        </DockPanel>
        <DockPanel side="right" size="20%" handle="attributesHeader">
            <Editor::Attributes
                bIsItemSelected="{{ bIsItemSelected }}"
                attributeGroups="{{ attributeGroups }}"
                onAttributeCommit="{{ onAttributeCommit }}"
            />
        </DockPanel>
        <DockPanel side="bottom" size="18em" handle="explorerHeader">
            <Editor::Explorer
                orientation="{{ orientation }}"
                onFolder="{{ onExplorerFolder }}"
                onAsset="{{ onExplorerAsset }}"
                onAssetDrop="{{ onExplorerAssetDrop }}"
            />
        </DockPanel>
    </Dock>
    <Dock dir:if="{{ bIsAssetsWorkspace }}" class="home__content">
        <DockPanel isGrabbable="false" handle="assetManagerHeader">
            <Editor::AssetManager
                selectedFolderPath="{{ selectedFolderPath }}"
                selectedAssetName="{{ selectedAssetName }}"
            />
        </DockPanel>
        <DockPanel side="left" size="18%" handle="explorerHeader">
            <Editor::Explorer
                orientation="{{ orientation }}"
                onFolder="{{ onExplorerFolder }}"
                onAsset="{{ onExplorerAsset }}"
                onAssetDrop="{{ onExplorerAssetDrop }}"
            />
        </DockPanel>
        <DockPanel side="right" size="15%" handle="outlinerHeader">
            <Editor::Outliner
                outlinerNodes="{{ outlinerNodes }}"
                onItemSelection="{{ onItemSelection }}"
                onItemToggle="{{ onItemToggle }}"
                onItemEdit="{{ onItemEdit }}"
                onItemIdInput="{{ onItemIdInput }}"
                onItemIdCommit="{{ onItemIdCommit }}"
            />
        </DockPanel>
    </Dock>
</View>
