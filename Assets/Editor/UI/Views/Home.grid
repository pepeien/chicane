<View path="home" class="home --{{ theme }}">
    <Header />
    <Dock>
        <DockPanel>
            <Telemetry />
            <Viewport />
        </DockPanel>
        <DockPanel side="right" size="25%" handle="outlinerTab">
            <Outliner />
        </DockPanel>
        <DockPanel side="bottom" size="30%" handle="explorerHeader">
            <Explorer />
        </DockPanel>
    </Dock>
</View>
