$headerSize: 3.5em;
$footerHeight: 22em;

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    background-color: $--white;

    Header {
        width: 100%;
        height: $headerSize;
        overflow: visible;
    }

    &__content {
        width: 100%;
        height: calc(100% - $footerHeight);
        gap: 0.25em;
        border-radius: 5px;

        Telemetry {
            position: absolute;
            padding: 0.2em;
        }

        Viewport {
            width: 100%;
            height: 100%;
        }

        Outliner {
            width: 100%;
            height: 100%;
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }

            .dock-header Text {
                color: #c8c8c8;
            }
        }

        Attributes {
            width: 100%;
            height: 100%;
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }

            .dock-header Text {
                color: #c8c8c8;
            }
        }
    }

    &__footer {
        width: 100%;
        height: $footerHeight;
        gap: 0.25em;
        border-radius: 5px;

        Explorer {
            width: 100%;
            height: 100%;
            overflow: hidden;

            .explorer {
                transition: background-color 300ms ease-in-out;
                background-color: $--white;

                Text {
                    color: $--black;
                }
            }

            .dock-header Text {
                color: #c8c8c8;
            }
        }
    }
}