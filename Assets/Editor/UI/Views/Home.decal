$headerSize: 3.5em;

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    transition: background-color 200ms ease-in-out;
    background-color: $--white;

    Editor::Header {
        width: 100%;
        height: $headerSize;
        overflow: visible;
    }

    &__content {
        width: calc(100% - 1em);
        height: calc(100% - $headerSize - 1.45em);
        gap: 0.5em;
        margin: auto;

        DockPanel {
            border: 1px solid $--light-grey;
            border-radius: 4px;
        }

        Editor::Telemetry {
            position: absolute;
            padding: 0.2em;
        }

        Viewport {
            width: 100%;
            height: 100%;
        }

        Editor::Outliner {
            width: 100%;
            height: 100%;

            Text {
                color: $--black;
            }
        }

        Editor::Attributes {
            width: 100%;
            height: 100%;

            Text {
                color: $--black;
            }
        }

        Editor::Explorer {
            width: 100%;
            height: 100%;
            overflow: hidden;

            .explorer {
                Text {
                    color: $--black;
                }
            }
        }
    }
}