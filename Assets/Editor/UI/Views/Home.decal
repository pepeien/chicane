$sideBarSize:   25vw;
$bottomBarSize: 30vh;

.theme-button {
    position: absolute;
    margin-left: calc(100% - calc($sideBarSize + 8em));
    width: 8em;
    height: 2em;
    background-color: $--dark-grey;

    Text {
        margin: auto;
    }
}

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    Viewport {
        position: absolute;
        width: calc(100% - $sideBarSize);
        height: calc(100% - $bottomBarSize);
    }

    Telemetry {
        padding: 0.2em;
    }

    Outliner {
        position: absolute;
        width: $sideBarSize;
        height: 100%;
        margin: 0 0 0 auto;

        .outliner {
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }
        }
    }

    Explorer {
        position: absolute;
        width: calc(100% - $sideBarSize);
        height: $bottomBarSize;
        margin: auto 0 0 0;

        .explorer {
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }
        }
    }

    Button:hover {
        cursor: pointer;
    }
}