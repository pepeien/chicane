$sideBarSize:   15vw;
$bottomBarSize: 20vh;

.theme-button {
    width: 10em;
    height: 2em;
    position: absolute;
    margin-left: calc(100% - calc($sideBarSize + 10em));
    background-color: $--dark-grey;

    Text {
        margin: auto;
    }
}

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #7575757b;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #7575757b;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    &__telemetry {
        padding: 0.2em;
    }

    &__outliner {
        position: absolute;
        width: $sideBarSize;
        height: 100%;
        margin: 0 0 0 auto;
        background-color: $--dark-grey;

        .outliner {
            background-color: $--dark-grey;
        }
    }

    &__explorer {
        position: absolute;
        width: calc(100% - $sideBarSize);
        height: $bottomBarSize;
        margin: auto 0 0 0;

        .explorer {
            background-color: $--dark-grey;
        }
    }

    Button:hover {
        cursor: pointer;
    }
}