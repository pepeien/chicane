$headerSize: 2em;

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #524e4e;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

.home {
    Header {
        width: 100%;
        height: $headerSize;
        overflow: visible;
    }

    Dock {
        width: 100%;
        height: calc(100% - $headerSize);
    }

    Viewport {
        width: 100%;
        height: 100%;
    }

    Telemetry {
        position: absolute;
        padding: 0.2em;
    }

    Outliner {
        width: 100%;
        height: 100%;

        .outliner {
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }
        }
    }

    Explorer {
        width: 100%;
        height: 100%;

        .explorer {
            transition: background-color 300ms ease-in-out;
            background-color: $--white;

            Text {
                color: $--black;
            }
        }
    }

    Button:hover {
        cursor: pointer;
    }
}