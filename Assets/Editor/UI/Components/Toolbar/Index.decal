.toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.5em;

    &__items {
        display: flex;
        flex-direction: column;
    }

    &__item {
        display: flex;
        flex-direction: column;
        padding: 0.65em;
        border-top: 1px solid $--black;
        background-color: $--white;
        transition: background-color 200ms ease-in-out;

        Icon {
            width: 1.1em;
            height: 1.1em;
            margin: auto;
            color: $--black;
            transition: color 200ms ease-in-out;
        }

        Tooltip {
            background-color: $--dark-gray;
            margin: -2.5em 0 0 3em;

            .tooltip__content {
                Text {
                    font-size: 0.6em;
                }
            }
        }

        &:hover {
            cursor: pointer;
            background-color: $--light-gray;

            Icon {
                color: $--gray;
            }
        }

        &.--active {
            background-color: $--green;

            Icon {
                color: $--black;

                &.--regular {
                    display: none;
                }
            }
        }
        

        &.--idle {
            Icon.--fill {
                display: none;
            }
        }

        &:first-of-type {
            border-top: none;
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
        }

        &:last-of-type {
            border-top: none;
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 4px;
        }
    }

    &__add {
        position: relative;
    }

    &__add-list {
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 0.25em;
        margin: calc(100% + 0.2em) 0 0 0;
        padding: 0.5em;
        width: 14em;
        border-radius: 5px;
        background-color: $--dark-gray;
        z-index: 99;
    }
}
