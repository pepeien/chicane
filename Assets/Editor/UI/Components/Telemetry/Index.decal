.telemetry {
    display: flex;
    flex-direction: column;

    &__group {
        display: flex;
        flex-direction: row;
        gap: 0 0.25em;

        Text {
            color: lime;
            font-size: 0.7em;
        }

        &__label {
            width: 3.5em;
            overflow: hidden;
        }
    }
}