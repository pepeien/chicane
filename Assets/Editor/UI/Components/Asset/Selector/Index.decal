.asset-selector {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 0.4em;
    overflow: hidden;

    &__preview {
        width: 3.2em;
        height: 3.2em;
        min-width: 3.2em;
        display: flex;
        background-color: $--light-gray;
        border: 1px solid $--lighter-gray;
        border-radius: 4px;
        overflow: hidden;
    }

    &__image {
        width: 100%;
        height: 100%;
        transform: rotate(180deg);
    }

    &__empty {
        margin: auto;
        font-size: 0.65em;
        color: $--gray;
    }

    &__body {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.25em;
        overflow: hidden;
    }

    &__label {
        width: 100%;
        font-size: 0.7em;
        color: $--black;
        overflow: hidden;
    }

    &__actions {
        display: flex;
        flex-direction: row;
        gap: 0.25em;
    }

    &__action {
        padding: 0.15em 0.45em;
        border-radius: 3px;
        background-color: $--light-gray;
        color: $--black;
        cursor: pointer;

        &:hover {
            background-color: $--dark-gray;
        }

        Text {
            font-size: 0.65em;
        }
    }
}
