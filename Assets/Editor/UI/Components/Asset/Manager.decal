$assetManagerHeaderHeight: 1.65em;

.asset-manager {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

    &__toolbar {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.35em;
        padding: 0.6em;
    }

    &__action, &__save {
        padding: 0.35em 0.7em;
        border-radius: 4px;
        background-color: $--light-grey;
        color: $--black;

        &:hover {
            cursor: pointer;
            background-color: $--dark-grey;
        }
    }

    &__editor, &__empty {
        width: 100%;
        padding: 0.6em;
        display: flex;
        flex-direction: column;
        gap: 0.45em;
    }

    &__row {
        width: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.5em;
        alignment: center;
    }

    &__label {
        width: 5em;
        color: $--black;
    }

    Input::Text {
        width: 100%;
        color: $--black;
        background-color: $--light-grey;
        border-radius: 4px;
        padding: 0.2em 0.4em;
    }

    Text {
        color: $--black;
    }
}
