$assetManagerHeaderHeight: 1.65em;

.asset-manager {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

    &__toolbar {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.35em;
        padding: 0.6em;
    }

    &__action, &__save {
        padding: 0.35em 0.7em;
        border-radius: 4px;
        background-color: $--light-grey;
        color: $--black;

        &:hover {
            cursor: pointer;
            background-color: $--dark-grey;
        }
    }

    &__stage {
        width: 100%;
        height: calc(100% - 12em);
        display: flex;
        flex-direction: row;
        overflow: hidden;
    }

    &__viewport {
        width: 100%;
        height: 100%;
        position: relative;
    }

    &__shape {
        position: absolute;
        top: 0.5em;
        right: 0.5em;
        width: 10em;
        height: 1.6em;
        z-index: 5;

        Input::Select {
            width: 100%;
            height: 100%;
            background-color: $--dark-grey;
            color: $--white;
            border-radius: 4px;
            margin: 0.5em 0 0 0.5em;

            .input-select {
                &__list {
                    margin-top: 2em;
                    background-color: $--dark-grey;
                    color: $--lighter-grey;
                }
            }
        }
    }

    &__editor, &__empty {
        width: 100%;
        padding: 0.6em;
        display: flex;
        flex-direction: column;
        gap: 0.45em;
    }

    &__row {
        width: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.5em;
        alignment: center;
    }

    &__label {
        width: 5em;
        color: $--black;
    }

    Viewport {
        width: 100%;
        height: 100%;
    }

    Input::Text {
        width: 100%;
        color: $--black;
        background-color: $--light-grey;
        border-radius: 4px;
        padding: 0.2em 0.4em;
    }

    Text {
        color: $--black;
    }
}
