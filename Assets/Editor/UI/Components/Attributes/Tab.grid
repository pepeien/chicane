<Container class="attributes__tab">
    <Button class="attributes__tab__button" onClick="{{ onDropdownClick() }}">
        <Text class="attributes__tab__button__label">{{ label }}</Text>
        <Icon source="Assets/Editor/UI/Icons/Regular" name="CaretDown" class="attributes__tab__button__status --{{ contentVisibility }}" />
    </Button>
    <Container class="attributes__tab__content --{{ contentVisibility }}">
        <Content />
    </Container>         
</Container>