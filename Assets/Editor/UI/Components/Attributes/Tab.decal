.attributes__tab {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3em;

    &__button {
        display: flex;
        flex-direction: row;
        border-radius: 5px;
        padding: 0.35em 1em;
        background-color: $--light-grey;
        overflow: hidden;
        z-index: 1;
        cursor: grab;

        &:hover {
            cursor: grab;
        }

        &__label {
            font-weight: 600;
            margin: auto 0 auto 0;
        }

        &__status {
            margin: auto 0 auto auto;
            transform: rotate(0deg);
            transform-origin: center;
            width: 1em;
            height: 1em;
            color: white;
            transition: transform 260ms ease-in-out;

            &.--visible {
                transform: rotate(-180deg);
            }
        }
    }

    &__content {
        display: flex;
        flex-direction: column;
        gap: 0.35em;
        width: 100%;
        height: 0px;
        overflow: hidden;
        background-color: $--dark-grey;
        border-radius: 5px;
        transition: transform 260ms ease-in-out;

        &.--visible {
            height: auto;
            padding: 1em;
        }
    }
}