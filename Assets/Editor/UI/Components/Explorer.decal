$explorerHeaderHeight: 1.65em;
$explorerFolder: #d4a017;
$explorerToolbarHeight: 2.15em;
$explorerFooterHeight: 2.4em;
$explorerChromeHeight: 5.25em;
$explorerTreeWidth: 15em;
$explorerSearchFilterWidth: 11.5em;

.explorer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $--white;
    overflow: hidden;

    &__body {
        width: 100%;
        height: calc(100% - $explorerHeaderHeight);
        display: flex;
        flex-direction: row;
        gap: 0.15em;
        overflow: hidden;
    }

    &__tree {
        width: calc($explorerTreeWidth - 0.4em);
        height: calc(100% - 0.7em);
        display: flex;
        flex-direction: column;
        padding: 0.35em 0.2em;
        overflow: auto;

        &__indent {
            width: ref(entry.indent);
            height: 1px;
        }

        &__item {
            width: calc(100% - 0.5em);
            height: 1.55em;
            display: flex;
            flex-direction: row;
            gap: 0.2em;
            padding: 0 0.25em;
            background-color: transparent;
            cursor: pointer;
            border-radius: 3px;
            overflow: hidden;
            transition: background-color 300ms ease-in-out;

            &:hover {
                background-color: $--light-grey;
            }

            &.--selected {
                background-color: $--light-grey;
            }
        }

        &__caret {
            width: 0.9em;
            height: 0.9em;
            display: flex;
            margin: auto 0;
            background-color: transparent;
            cursor: pointer;

            &__icon {
                width: 0.55em;
                height: 0.55em;
                margin: auto;
                color: $--grey;
                transform-origin: center;
            }

            &.--expanded .explorer__tree__caret__icon {
                rotate: 90deg;
            }

            &.--leaf {
                opacity: 0;
                cursor: default;
            }
        }

        &__icon {
            width: 0.95em;
            height: 0.95em;
            margin: auto 0;
            color: $explorerFolder;
        }

        &__name {
            font-size: 0.72em;
            margin: auto 0;
            color: $--black;
        }
    }

    &__main {
        width: calc(100% - calc($explorerTreeWidth + 0.8em));
        height: calc(100% - 0.6em);
        display: flex;
        flex-direction: column;
        gap: 0.35em;
        padding: 0.35em 0.45em 0.25em 0.35em;
    }

    &__toolbar {
        width: 100%;
        height: $explorerToolbarHeight;
        display: flex;
        flex-direction: row;
        gap: 0.4em;
    }

    &__search {
        width: calc(100% - calc($explorerSearchFilterWidth + 1.1em));
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.35em;
        padding: 0 0.55em;
        background-color: $--dark-grey;
        border-radius: 4px;
        overflow: hidden;

        &__icon {
            width: 0.85em;
            height: 0.85em;
            margin: auto 0;
            color: $--grey;
        }

        TextInput {
            width: calc(100% - 1.4em);
            height: 100%;
            color: $--black;
        }
    }

    &__filter {
        width: $explorerSearchFilterWidth;
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.35em;
        padding: 0 0.7em;
        background-color: $--green;
        border-radius: 4px;
        cursor: pointer;

        &__icon {
            width: 0.85em;
            height: 0.85em;
            margin: auto 0;
            color: $--white;
        }

        Text {
            font-size: 0.78em;
            margin: auto 0;
            color: $--white;
        }
    }

    &__grid {
        width: 100%;
        height: calc(100% - 9.5em);

        &__content {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.55em;
            overflow: auto;

            &.--vertical {
                flex-direction: column;
                flex-wrap: nowrap;
                gap: 0.2em;
            }
        }
    }

    ExplorerItem {
        width: ref(iconSize);
        height: ref(iconSize);
        overflow: hidden;

        &.--vertical {
            width: 100%;
            height: 2.5em;
        }
    }

    &__footer {
        width: calc(100% - 0.3em);
        height: $explorerFooterHeight;
        display: flex;
        flex-direction: row;
        gap: 1.2em;
        padding: 0 0.15em;

        &__group {
            display: flex;
            flex-direction: row;
            gap: 0.35em;
            margin: auto 0;

            &.--grow {
                width: 18em;
            }
        }

        &__label {
            font-size: 0.7em;
            margin: auto 0.2em auto 0;
            color: $--grey;
        }
    }

    &__toggle {
        height: 1.55em;
        display: flex;
        padding: 0 0.7em;
        background-color: $--light-grey;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 300ms ease-in-out;

        Text {
            font-size: 0.7em;
            margin: auto;
            color: $--white;
        }

        &.--active {
            background-color: $--green;
        }
    }

    &__slider {
        width: 12em;
        height: 1.2em;
        position: relative;
        cursor: ew-resize;

        &__track {
            width: 100%;
            height: 0.28em;
            margin: auto 0;
            background-color: $--light-grey;
            border-radius: 1em;
            overflow: hidden;
        }

        &__fill {
            width: ref(iconSizePercent)%;
            height: 100%;
            background-color: $--green;
        }

        &__thumb {
            position: absolute;
            width: 0.72em;
            height: 0.72em;
            margin-top: 0.24em;
            margin-left: ref(iconSizePercent)%;
            background-color: $--green;
            border-radius: 1em;
        }
    }
}
