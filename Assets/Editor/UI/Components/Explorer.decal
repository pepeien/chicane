$explorerHeaderHeight: 2em;

.explorer {
    width: 100%;
    height: 100%;

    &__header {
        width: 100%;
        height: $explorerHeaderHeight;
        display: flex;
        flex-direction: row;
        gap: 0 0.25em;
        background-color: $--white;

        &__location {
            display: flex;
            flex-direction: row;
            gap: 0 0.25em;
        }
    }

    &__items {
        height: calc(100% - $explorerHeaderHeight);
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5em;
        overflow: hidden;
        overflow-y: auto;
    }
}