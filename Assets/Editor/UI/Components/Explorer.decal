$explorerHeaderHeight: 1.65em;
$explorerFolder: #d4a017;
$explorerToolbarHeight: 2.15em;
$explorerFooterHeight: 2.4em;
$explorerChromeHeight: 5.25em;
$explorerTreeWidth: 15em;
$explorerSearchFilterWidth: 11.5em;
$explorerPortraitTreeHeight: 11.5em;
$explorerPortraitToolbarHeight: 4.7em;
$explorerPortraitFooterHeight: 2.4em;
$explorerSliderThumb: 0.72em;

.explorer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $--white;
    overflow: hidden;

    &__body {
        width: 100%;
        height: calc(100% - $explorerHeaderHeight);
        display: flex;
        flex-direction: row;
        overflow: hidden;
    }

    &__tree {
        width: $explorerTreeWidth;
        height: calc(100% - 0.5em);
        display: flex;
        flex-direction: column;
        padding: 0.6em 0.35em;
        overflow: hidden;
        overflow-y: auto;
        gap: 0.25em;
        border-right: 1px solid $--light-grey;
        margin: auto 0;

        &__item {
            width: calc(100% - ref(entry.indent));
            height: 1.55em;
            display: flex;
            flex-direction: row;
            gap: 0.2em;
            padding: 0 0.25em;
            background-color: transparent;
            border-radius: 3px;
            overflow: hidden;
            transition: background-color 300ms ease-in-out;
            margin-left: ref(entry.indent);

            &:hover {
                cursor: pointer;
                background-color: $--light-grey;
            }

            &.--selected {
                background-color: $--light-grey;
            }

            &__icon {
                width: 0.95em;
                height: 0.95em;
                margin: auto 0;
                color: $explorerFolder;
            }

            &__name {
                font-size: 0.72em;
                margin: auto 0;
                color: $--grey;
            }

            &__caret {
                width: 0.55em;
                height: 0.55em;
                margin: auto 0;
                color: $--grey;
                transform-origin: center;
                transition: transform 200ms ease-in-out;

                &.--expanded {
                    transform: rotate(180deg);
                }

                &.--leaf {
                    opacity: 0;
                    cursor: default;
                }
            }
        }
    }

    &__main {
        width: calc(100% - $explorerTreeWidth);
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.35em;
        padding: 0.35em 0.45em 0.25em 0.35em;
    }

    &__toolbar {
        width: 100%;
        height: $explorerToolbarHeight;
        display: flex;
        flex-direction: row;
        gap: 0.4em;
    }

    &__search {
        width: calc(100% - $explorerSearchFilterWidth);
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.35em;
        padding: 0 0.55em;
        background-color: $--dark-grey;
        border-radius: 4px;
        overflow: hidden;

        &__icon {
            width: 0.85em;
            height: 0.85em;
            margin: auto 0;
            color: $--grey;
        }

        TextInput {
            width: calc(100% - 1.4em);
            height: 1em;
            margin: auto 0;
            color: $--black;
        }
    }

    &__filter {
        width: $explorerSearchFilterWidth;
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.35em;
        padding: 0 0.7em;
        background-color: $--green;
        border-radius: 4px;
        cursor: pointer;

        &__icon {
            width: 0.85em;
            height: 0.85em;
            margin: auto 0;
            color: $--white;
        }

        Text {
            font-size: 0.78em;
            margin: auto 0;
            color: $--white;
        }
    }

    &__grid {
        width: 100%;
        height: calc(100% - $explorerToolbarHeight - $explorerFooterHeight);

        &__content {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.55em;
            overflow: auto;

            &.--vertical {
                flex-direction: column;
                flex-wrap: nowrap;
                gap: 0.2em;
            }
        }
    }

    ExplorerItem {
        width: ref(iconSize);
        height: ref(iconSize);
        overflow: hidden;

        &.--vertical {
            width: 100%;
            height: 2.5em;
        }
    }

    &__footer {
        width: 100%;
        height: $explorerFooterHeight;
        display: flex;
        flex-direction: row;
        gap: 1.2em;
        padding: 0 0.15em;

        &__group {
            display: flex;
            flex-direction: row;
            gap: 0.35em;
            margin: auto 0;

            &.--grow {
                width: 18em;
            }
        }

        &__label {
            font-size: 0.7em;
            margin: auto 0.2em auto 0;
            color: $--black;
        }
    }

    &__toggle {
        height: 1.55em;
        display: flex;
        padding: 0 0.7em;
        background-color: $--light-grey;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 300ms ease-in-out;

        Text {
            font-size: 0.7em;
            margin: auto;
            color: $--white;
        }

        &.--active {
            background-color: $--green;
        }
    }

    &__slider {
        width: 12em;
        height: 1.2em;
        position: relative;
        cursor: ew-resize;

        &__track {
            width: 100%;
            height: 0.28em;
            margin: auto 0;
            background-color: $--light-grey;
            border-radius: 1em;
            overflow: hidden;
        }

        &__fill {
            width: ref(iconSizePercent)%;
            height: 100%;
            background-color: $--green;
        }

        &__thumb {
            position: absolute;
            width: $explorerSliderThumb;
            height: $explorerSliderThumb;
            margin-top: 0.24em;
            margin-left: calc(calc(100% - $explorerSliderThumb) * ref(iconSizePercent) / 100);
            background-color: $--green;
            border-radius: 1em;
        }
    }

    &.--portrait {
        .explorer {
            &__body {
                flex-direction: column;
            }

            &__tree {
                width: calc(100% - 0.5em);
                height: $explorerPortraitTreeHeight;
                border-right: none;
                border-bottom: 1px solid $--light-grey;
                margin: 0 auto;
            }

            &__main {
                width: 100%;
                height: calc(100% - $explorerPortraitTreeHeight - 0.15em);
            }

            &__toolbar {
                flex-direction: row;
                height: $explorerToolbarHeight;
            }

            &__search {
                width: 60%;
            }

            &__filter {
                width: 40%;
                overflow: hidden;
            }

            &__grid {
                height: calc(100% - $explorerPortraitToolbarHeight - $explorerPortraitFooterHeight);
            }

            &__footer {
                flex-direction: column;
                gap: 0.25em;
                height: $explorerPortraitFooterHeight;

                &__group {
                    width: 100%;
                    margin: 0;

                    &.--grow {
                        width: 100%;
                    }
                }

                &__label {
                    display: none;
                }
            }

            &__slider {
                width: 100%;
            }

            &__toggle {
                padding: 0 0.5em;
            }
        }
    }
}
