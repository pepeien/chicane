$attributesHeaderHeight: 1.65em;

.attributes {
    width: 100%;
    height: 100%;

    &__content {
        width: 100%;
        height: calc(100% - $attributesHeaderHeight);
        padding: 0.5em;
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 0.35em;
    }

    &__transforms {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.25em;
    }

    &__transform {
        width: 100%;
        display: flex;
        flex-direction: row;

        &__label {
            width: 40%;
            max-width: 6em;
        }

        Editor::Vec3 {
            width: 100%;
        }
    }

    &__field {
        width: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.4em;
        alignment: center;

        &__label {
            width: 40%;
            max-width: 7em;
        }

        Input::Text, Input::Select {
            width: 100%;
            color: $--black;
        }
    }
}
