$attributesHeaderHeight: 1.65em;

.attributes {
    width: 100%;
    height: 100%;

    &__content {
        width: 100%;
        height: calc(100% - $attributesHeaderHeight);
        padding: 0.5em;
        overflow: hidden;
    }

    &__transforms {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.25em;
    }

    &__transform {
        width: 100%;
        display: flex;
        flex-direction: row;

        &__label {
            width: 40%;
            max-width: 6em;
        }

        Vec3 {
            width: 100%;
        }
    }
}
