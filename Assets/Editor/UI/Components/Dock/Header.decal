$dockHeaderHeight: 1.65em;

.dock-header {
    width: 100%;
    height: $dockHeaderHeight;
    display: flex;
    flex-direction: row;
    padding: 0 0.35em;
    background-color: $--dark-grey;
    cursor: grab;

    &.--pinned {
        cursor: default;
    }

    Text {
        color: $--grey;
    }

    &__label {
        font-size: 0.72em;
        margin: auto 0;
    }

    &__actions {
        display: flex;
        flex-direction: row;
        height: 100%;
        margin-left: auto;
        gap: 0.25em;
        padding: 0.25em 0;
    }

    &__action {
        width: 1.25em;
        height: 100%;
        display: flex;
        alignment: center;
        background-color: transparent;
        border-radius: 4px;
        transition: background-color 100ms ease-in-out;
        margin: auto 0;

        &__icon {
            width: 0.72em;
            height: 0.72em;
            margin: auto;
            color: $--grey;
            transform-origin: center;
            transition: transform 150ms ease-in-out;

            &.--pin {
                transform: rotate(-45deg);
            }
        }

        &:hover {
            cursor: pointer;
            background-color: $--light-grey;
        }

        &.--pinned {
            .dock-header__action__icon.--pin {
                transform: rotate(0deg);
            }
        }
    }
}
