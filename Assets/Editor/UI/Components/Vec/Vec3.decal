.vector-3d {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    gap: 0.5em;

    &__value {
        width: 33%;
        display: flex;
        flex-direction: row;
        gap: 0.25em;
        background-color: $--light-grey;
        padding: 0.05em;
        border-radius: 0.15em;
        overflow: hidden;

        &__label {
            height: 1em;
            width: 2px;

            &.--x {
                background-color: red;
            }

            &.--y {
                background-color: green;
            }

            &.--z {
                background-color: blue;
            }
        }

        TextInput {
            width: 100%;
            height: 100%;
            color: $--black;
        }
    }
}