<Container class="vector-3d">
    <Container class="vector-3d__value">
        <Container class="vector-3d__value__label --x" />
        <TextInput value="{{ value.x }}" onInput="{{ commit() }}"/>
    </Container>
    <Container class="vector-3d__value">
        <Container class="vector-3d__value__label --y" />
        <TextInput value="{{ value.y }}" onInput="{{ commit() }}"/>
    </Container>
    <Container class="vector-3d__value">
        <Container class="vector-3d__value__label --z" />
        <TextInput value="{{ value.z }}" onInput="{{ commit() }}"/>
    </Container>
</Container>