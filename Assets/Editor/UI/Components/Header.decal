.header {
    width: 100%;
    height: 100%;
    display: flex;
    overflow: visible;
    transition: background-color 300ms ease-in-out;
    background-color: $--white;

    &:drag {
        cursor: grabbing;
    }

    Logo {
        width: 2em;
        height: 2em;
    }

    &__menus {
        display: flex;
        height: 100%;
        overflow: visible;
    }

    Text {
        color: $--black;
    }

    &__theme {
        width: 8em;
        height: 100%;
        margin: 0 0 0 auto;

        .select__control, .select__list {
            background-color: $--dark-grey;
        }

        Option:hover, Option.--active, Option.--selected {
            background-color: $--light-grey;
        }
    }

    &__controls {
        display: flex;
        gap: 0.2em;
        height: 100%;
        margin-left: auto
    }

    &__control {
        width: 2.5em;
        height: 100%;
        display: flex;
        cursor: pointer;
        background-color: transparent;
        transition: background-color 100ms ease-out;

        &__icon {
            width: 1em;
            height: 1em;
            margin: auto;
            color: $--black;

            &.--restore {
                display: none;
            }
        }

        &:hover {
            background-color: $--light-grey;
        }

        &.--maximized {
            .header__control__icon.--maximize {
                display: none;
            }

            .header__control__icon.--restore {
                display: block;
            }
        }

        &.--restored {
            .header__control__icon.--maximize {
                display: block;
            }

            .header__control__icon.--restore {
                display: none;
            }
        }

        &.--close {
            .header__control__icon {
                rotate: 45deg;
                transform-origin: center;
            }
        }

        &.--close:hover {
            background-color: #e81123;

            .header__control__icon {
                color: #ffffff;
            }
        }
    }
}
