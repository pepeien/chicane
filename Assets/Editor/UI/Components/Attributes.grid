<Container class="attributes">
    <Editor::DockHeader id="attributesHeader" label="Attributes" />
    <Container dir:if="{{ bIsItemSelected }}" class="attributes__content">
        <Editor::AttributesTab
            dir:for="group : attributeGroups"
            label="{{ group.label }}"
        >
            <Container
                dir:for="attribute : group.fields"
                class="attributes__field"
            >
                <Container class="attributes__field__label">
                    <ToolTip
                        dir:if="{{ attribute.description.isEmpty() }}"
                        handleId="label-{{ attribute.name }}"
                        title="{{ attribute.description }}"
                    />
                    <Text id="label-{{ attribute.name }}">{{ attribute.label }}</Text>
                </Container>
                <Input::Text
                    dir:if="{{ attribute.type == Text }}"
                    value="{{ attribute.text }}"
                    onInput="{{ onAttributeCommit(attribute.name, value) }}"
                />
                <Button::Check
                    dir:if="{{ attribute.type == Bool }}"
                    checked="{{ attribute.bIsChecked }}"
                    onInput="{{ onAttributeCommit(attribute.name, isChecked) }}"
                />
                <Input::Select
                    dir:if="{{ attribute.type == Enum }}"
                    value="{{ attribute.text }}"
                    items="{{ attribute.options }}"
                    onInput="{{ onAttributeCommit(attribute.name, value) }}"
                />
                <Input::Text
                    dir:if="{{ attribute.type == Float }}"
                    value="{{ attribute.text }}"
                    onInput="{{ onAttributeCommit(attribute.name, value) }}"
                />
                <Editor::Vec3
                    dir:if="{{ attribute.type == Vec3 }}"
                    value="{{ attribute.vector }}"
                    onInput="{{ onAttributeCommit(attribute.name, value) }}"
                />
                <Input::Color
                    dir:if="{{ attribute.type == Color }}"
                    value="{{ attribute.vector }}"
                    onInput="{{ onAttributeCommit(attribute.name, hex) }}"
                />
                <Editor::AssetSelector
                    dir:if="{{ attribute.type == Asset }}"
                    value="{{ attribute.text }}"
                    kind="{{ attribute.kind }}"
                    onInput="{{ onAttributeCommit(attribute.name, value) }}"
                />
            </Container>
        </Editor::AttributesTab>
    </Container>
</Container>
