<Container class="attributes">
    <Editor::DockHeader id="attributesHeader" label="Attributes" />
    <Container dir:if="{{ bIsItemSelected }}" class="attributes__content">
        <Editor::AttributesTab class="attributes__transforms" label="Transform">
            <Container class="attributes__transform">
                <Container class="attributes__transform__label">
                    <Text>Translation</Text>
                </Container>
                <Editor::Vec3 value="{{ selectedItem.translation }}" />
            </Container>
            <Container class="attributes__transform">
                <Container class="attributes__transform__label">
                    <Text>Rotation</Text>
                </Container>
                <Editor::Vec3 value="{{ selectedItem.rotation }}" />
            </Container>
            <Container class="attributes__transform">
                <Container class="attributes__transform__label">
                    <Text>Scale</Text>
                </Container>
                <Editor::Vec3 value="{{ selectedItem.scale }}" />
            </Container>
        </Editor::AttributesTab>
    </Container>
</Container>
