Editor::ViewportSettings {
    position: absolute;
    width: 18.5em;
    z-index: 90;
    background-color: #323232;
    border: 1px solid #524e4e;
    border-radius: 4px;
}

.viewport-settings {
    width: 100%;
    background-color: #323232;

    &__body {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding: 0.45em 0.75em;
        gap: 0.28em;
        overflow: auto;
    }

    &__section-title {
        width: 100%;
        margin: 0.25em 0 0.25em 0.05em;
        color: $--gray;
        opacity: 0.7;
        font-size: 0.68em;
    }

    &__cols {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.3em;
    }

    &__row {
        width: 100%;
        display: flex;
        flex-direction: row;
        gap: 0.3em;
        overflow: hidden;
    }

    &__checks {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;

        Button::Check {
            width: 50%;
            height: 1.35em;
        }
    }

    &__inline-label {
        margin: auto 0;
        color: $--black;
        font-size: 0.72em;
        margin-right: 0.25em;
    }

    &__axes {
        display: flex;
        flex-direction: row;
        margin: auto 0 auto auto;
        border-radius: 3px;
    }

    &__axis {
        display: flex;
        padding: 0.25em;
        background-color: $--light-gray;

        &:hover {
            cursor: pointer;
        }

        Text {
            margin: auto;
            color: white;
            font-size: 0.68em;
        }

        &.--on {
            &.--x {
                background-color: #CF1C46;
            }

            &.--y {
                background-color: #60AB80;
            }

            &.--z {
                background-color: #4875CA;
            }
        }

        &.--y {
            border-left: 1px solid transparent;
            border-right: 1px solid transparent;
        }
    }

    Input::ButtonSlider {
        width: 100%;
        height: 1.4em;
        margin: auto 0;

        .input-button-slider {
            &__label, &__value {
                font-size: 0.65em; 
            }
        }
    }

    Input::Color {
        width: 40%;
        margin-left: auto;
    }

    Button::Check {
        .button-check {
            gap: 0.35em;
        }

        .button-check__box {
            width: 0.95em;
            height: 0.95em;
            background-color: $--white;
            border: 1px solid $--lighter-gray;
            border-radius: 2px;
        }

        .button-check__tick {
            background-color: #ffffff;
        }

        .button-check.--checked .button-check__box {
            background-color: #4772b3;
            border: 1px solid #4772b3;
        }

        Text {
            color: $--black;
            font-size: 0.72em;
        }
    }
}
