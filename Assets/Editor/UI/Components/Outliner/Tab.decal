.outliner__tab {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    overflow: hidden;

    &__button {
        display: flex;
        flex-direction: row;
        border-radius: 5px;
        padding: 0.35em 1em;
        background-color: $--light-grey;
        overflow: hidden;
        z-index: 1;

        &__label {
            font-weight: 600;
            margin: auto 0 auto 0;
        }

        &__status {
            margin: auto 0 auto auto;
            rotate: -90deg;
            transform-origin: center;
            width: 1em;
            height: 1em;
            color: white;

            &.--visible {
                transition: rotate 260ms ease-in-out;
                rotate: 90deg;
            }
        }
    }

    &__content {
        width: calc(100% - 2em);
        overflow: hidden;
        background-color: $--dark-grey;
        border-radius: 5px;
        transform: translateY(-100%);
        padding: 1em;

        &.--visible {
            transition: transform 260ms ease-in-out;
            transform: translateY(0px);
        }
    }
}