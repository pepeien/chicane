<Container class="outliner__tab">
    <Button id="outlinerTab" class="outliner__tab__button" onClick="{{ onDropdownClick() }}">
        <Text class="outliner__tab__button__label">{{ label }}</Text>
        <Svg class="outliner__tab__button__status --{{ contentVisibility }}" viewBox="0 0 185.343 185.343">
            <SvgPath d="M51.707,185.343c-2.741,0-5.493-1.044-7.593-3.149c-4.194-4.194-4.194-10.981,0-15.175 l74.352-74.347L44.114,18.32c-4.194-4.194-4.194-10.987,0-15.175c4.194-4.194,10.987-4.194,15.18,0l81.934,81.934 c4.194,4.194,4.194,10.987,0,15.175l-81.934,81.939C57.201,184.293,54.454,185.343,51.707,185.343z"/>
        </Svg>
    </Button>
    <Container class="outliner__tab__content --{{ contentVisibility }}">
        <Content />
    </Container>         
</Container>