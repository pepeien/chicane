<Container class="outliner">
    <Editor::DockHeader id="outlinerHeader" label="Outliner" />
    <Container class="outliner__items">
        <Container
            dir:for="node : outlinerNodes"
            class="outliner__item --{{ node.selectedState }}"
        >
            <Button
                dir:if="{{ node.bHasChildren }}"
                class="outliner__item__caret --{{ node.expandState }}"
                onClick="{{ onItemToggle(node.item) }}"
            >
                <Icon source="Assets/Editor/UI/Icons/Fill" name="CaretDown" class="outliner__item__caret__icon --{{ node.expandState }}"/>
            </Button>
            <Icon
                dir:if="{{ node.bIsLeaf }}"
                source="Assets/Editor/UI/Icons/Fill"
                name="CaretDown"
                class="outliner__item__caret --leaf"
            />
            <Button
                dir:if="{{ node.bShowLabel }}"
                class="outliner__item__body"
                onClick="{{ onItemSelection(node.item) }}"
            >
                <Icon source="Assets/Editor/UI/Icons/Fill" name="{{ node.icon }}" class="outliner__item__icon"/>
                <Text>{{ node.label }}</Text>
            </Button>
            <Container dir:if="{{ node.bIsEditing }}" class="outliner__item__body --editing">
                <Icon source="Assets/Editor/UI/Icons/Fill" name="{{ node.icon }}" class="outliner__item__icon"/>
                <Input::Text
                    class="outliner__item__input"
                    value="{{ node.label }}"
                    onInput="{{ onItemIdInput(node.item, value) }}"
                />
            </Container>
        </Container>
    </Container>
</Container>
