.explorer__item {
    width: ref(iconSize);
    height: ref(iconSize);
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    background-color: transparent;
    cursor: pointer;
    overflow: hidden;

    &__preview {
        width: 100%;
        height: calc(100% - 1em);
        position: relative;
        display: flex;
        background-color: $--dark-grey;
        border-radius: 4px;
        overflow: hidden;
        transition: background-color 300ms ease-in-out;
    }

    &__badge {
        position: absolute;
        width: 1em;
        height: 1em;
        margin: 0.25em;
        color: $--grey;
        z-index: 2;
    }

    &__glyph {
        width: 42%;
        height: 42%;
        margin: auto;
        color: $--grey;

        &.--folder {
            color: $--grey;
        }
    }

    &__image {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: transparent;
    }

    &__name {
        width: 100%;
        height: 1.1em;
        font-size: 0.68em;
        color: $--black;
        overflow: hidden;
    }

    &.--selected .explorer__item__preview {
        background-color: $--light-grey;
    }

    &:hover .explorer__item__preview {
        background-color: $--light-grey;
    }

    &.--draggable {
        cursor: grab;

        &:drag {
            cursor: grabbing;
        }
    }

    &.--ghost {
        opacity: 0.55;
        z-index: 999;
        cursor: grabbing;
    }

    &.--hidden {
        display: none;
    }

    &.--vertical {
        width: 100%;
        height: calc(ref(iconSize) * 0.37 + 0.5em);
        flex-direction: row;
        padding: 0 0.25em;
        gap: 0.45em;
        transition: background-color 200ms ease-in-out;


        &:hover {
            background-color: $--light-grey;

            .explorer__item__preview {
                background-color: $--dark-grey;
            }
        }

        .explorer__item {
            &__preview {
                width: calc(ref(iconSize) * 0.37);
                height: calc(ref(iconSize) * 0.37);
                margin: auto 0;
            }

            &__glyph {
                width: 52%;
                height: 52%;
            }

            &__badge {
                width: 25%;
                height: 25%;
                margin: 7%;
            }

            &__name {
                width: calc(100% - ref(iconSize) * 0.37 - 0.45em);
                height: auto;
                margin: auto 0;
                font-size: 0.75em;
            }
        }
    }
}
