.explorer__item {
    display: flex;
    height: 5.5em;
    width: 10em;
    background-color: $--green;
    overflow: auto;
    transition: background-color 200ms ease-in-out;

    Text {
        color: $--white;
        margin: auto;
        transition: color 200ms ease-in-out;
    }

    &:hover {
        cursor: pointer;
        background-color: $--white;

        Text {
           color: $--black; 
        }
    }
}