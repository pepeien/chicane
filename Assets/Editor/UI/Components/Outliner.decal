.outliner {
    width: 100%;
    height: 100%;
    padding: 0.5em;

    &__items {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        overflow-y: auto;
    }

    &__item-detail {
        &__transforms {
            display: flex;
            flex-direction: column;
            gap: 0.25em;
        }

        &__transform {
            display: flex;
            flex-direction: row;
            gap: 1em;

            &__label {
                width: 6em;
            }

            Vec3 {
                margin-left: auto;
            }
        }
    }
}