@import(Font, Assets/Engine/Fonts/Poppins.bfon);

$sideBarSize:   15vw;
$bottomBarSize: 20vh;

.menu {
    position: absolute;
    background-color: #242424;

    &.--side {
        display: flex;
        flex-direction: column;
        width: $sideBarSize;
        height: 100%;
        margin-left: auto;
    }

    &.--bottom {
        width: auto;
        height: $bottomBarSize;
        margin-top: auto;
        margin-right: $sideBarSize;
    }
}

.button {
    width: calc(100% - 2em);
    height: 2em;
    background-color: gray;
    margin: auto auto 1em auto;
    alignment: center;
}