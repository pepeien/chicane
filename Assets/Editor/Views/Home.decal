@import(Font, Assets/Engine/Fonts/Poppins.bfon);

$sideBarSize:   15vw;
$bottomBarSize: 20vh;

$explorerHeaderHeight: 2em;

.--light {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #7575757b;
    $--dark-grey: #323232;

    $--black: #252525;
    $--white: #f7f7f7;
}

.--dark {
    $--green: #0b997d;

    $--grey: #aaaaaa;
    $--light-grey: #7575757b;
    $--dark-grey: #323232;

    $--black: #f7f7f7;
    $--white: #252525;
}

Button:hover {
    cursor: pointer;
}

.telemetry {
    padding: 0.2em;
}

.theme-button {
    width: 10em;
    height: 2em;
    position: absolute;
    margin-left: calc(100% - calc($sideBarSize + 10em));
    background-color: $--dark-grey;

    Text {
        margin: auto;
    }
}

.--menu {
    position: absolute;
    background-color: $--dark-grey;
}

.outliner {
    display: flex;
    flex-direction: column;
    width: $sideBarSize;
    height: 100%;
    margin-left: auto;
    overflow: hidden;
    overflow-y: auto;
}

.explorer {
    width: calc(100% - $sideBarSize);
    height: $bottomBarSize;
    margin-top: auto;
    margin-right: $sideBarSize;

    &__header {
        width: 100%;
        height: $explorerHeaderHeight;
        display: flex;
        flex-direction: row;
        gap: 0 0.25em;
        background-color: $--white;

        &__location {
            display: flex;
            flex-direction: row;
            gap: 0 0.25em;
        }
    }

    &__items {
        height: calc(100% - $explorerHeaderHeight);
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5em;
        overflow: hidden;
        overflow-y: auto;
    }

    &__item {
        height: 5.5em;
        width: 10em;
        background-color: $--green;
        overflow: auto;

        Text {
            color: $--white;
            margin: auto;
        }
    }
}