<View path="home" style="Assets/Editor/Views/Home.decal">
    <Container class="telemetry">
        <Text>{{ telemetry.renderer.frame.rate }} FPS</Text>
        <Text>{{ telemetry.renderer.frame.delta }} ms</Text>
    </Container>
    <Container class="outliner --menu">
        <Container class="outliner__items">
            <Button dir:for="actor : outlinerActors" class="outliner__item">
                <Text>{{ actor.translation }}</Text>
            </Button>
        </Container>
        <Button onClick="{{ onAssetImport() }}" class="outliner__import-button">
            <Text>Import File</Text>
        </Button>
    </Container>
    <Container class="explorer --menu">
        <Container class="explorer__header">
            <Text>/</Text>
            <Button dir:for="folder : getFolderLocations()" class="explorer__header__location">
                <Text>{{ folder }}</Text>
                <Text>/</Text>
            </Button>
        </Container>
        <Container class="explorer__items">
            <Button
                dir:for="child : explorerFolder.children"
                class="explorer__item"
                onClick="{{ onOutlinerSwitch(child.name) }}"
            >
                <Text>{{ child.name }}</Text>
            </Button>
        </Container>
    </Container>
</View>