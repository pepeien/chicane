# Project Information
PROJECT_NAME           = "Chicane"
PROJECT_BRIEF          = "A graphics engine"
PROJECT_NUMBER         = "0.0.1"

# Input
INPUT                  = Includes
FILE_PATTERNS          = *.hpp
EXCLUDE_PATTERNS       = */Vendor/* */Vendors/*
RECURSIVE              = YES
DOT_GRAPH_MAX_NODES    = 100

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Source Browser
SOURCE_BROWSER         = YES
VERBATIM_HEADERS       = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = NO
PREDEFINED             = \
    CH_TYPE(...)= \
    CH_ENUM(...)= \
    CH_FIELD(...)= \
    CH_FUNCTION(...)= \
    CH_CONSTRUCTOR(...)= \
    CHICANE_BOX= \
    CHICANE_CORE= \
    CHICANE_DRIFT= \
    CHICANE_GRID= \
    CHICANE_KERB= \
    CHICANE_RENDERER= \
    CHICANE_RUNTIME= \
    CHICANE_SCREECH=

# Output
OUTPUT_DIRECTORY       = .docs
CREATE_SUBDIRS         = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        =
HIDE_SCOPE_NAMES       = NO

# Output Formats
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Cross-referencing
TEMPLATE_RELATIONS     = YES

# Optional
QUIET                  = NO

# Optimization
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
